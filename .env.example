# Copy to .env for local use. Never commit .env or put secrets in the Android client.
PORT=3000
NODE_ENV=development
DATA_DIR=./data
TRUST_PROXY=false
# Create a strong secret using: openssl rand -base64 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Newly rotated Cartesia standard API key, set only on the trusted server.
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
